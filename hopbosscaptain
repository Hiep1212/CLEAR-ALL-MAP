-- ================= HOP LOGIC =================
local TriedHops = {}
local lastAttemptJobId = nil
local lastAttemptFailed = false

TeleportService.TeleportInitFailed:Connect(function(player, teleportResult, errorMessage)
    warn("Teleport failed:", teleportResult, errorMessage)
    if lastAttemptJobId then
        TriedHops[lastAttemptJobId] = os.time() + 600 -- Blacklist 10 phút nếu fail
    end
    lastAttemptFailed = true
end)

local function executeHop(jobId)
    lastAttemptJobId = jobId
    lastAttemptFailed = false
    local ok = pcall(function()
        ReplicatedStorage.__ServerBrowser:InvokeServer("teleport", jobId or "")
    end)
    return ok
end

-- 1. Tìm Server qua Web API (Siêu nhanh, tự sắp xếp ít người)
local function getServersHTTP(cursor)
    if not httpRequest then return nil end
    local url = string.format("https://games.roblox.com/v1/games/%d/servers/Public?sortOrder=Asc&limit=100%s", placeId, cursor and ("&cursor=" .. cursor) or "")
    local ok, res = pcall(function()
        return httpRequest({ Url = url, Method = "GET" })
    end)
    
    if ok and res and res.StatusCode == 200 then
        local decodeOk, data = pcall(function() return HttpService:JSONDecode(res.Body) end)
        if decodeOk then return data end
    end
    return nil
end

local function hopViaHTTP(maxPlayers)
    setStatus("Đang tìm server ít người (API)...")
    local cursor = nil
    local now = os.time()
    
    for _ = 1, 3 do -- Duyệt tối đa 3 trang API (300 servers)
        if stopped then return false end
        local data = getServersHTTP(cursor)
        
        if data and data.data then
            for _, server in ipairs(data.data) do
                if stopped then return false end
                local jobId = server.id
                local count = server.playing
                
                if jobId ~= currentJobId and count < maxPlayers and (not TriedHops[jobId] or now > TriedHops[jobId]) then
                    TriedHops[jobId] = now + 180 -- Đánh dấu đã thử
                    setStatus(string.format("Vào server %d người (API)...", count))
                    
                    local sent = executeHop(jobId)
                    task.wait(2)
                    
                    if sent and not lastAttemptFailed then
                        for i = 3, 1, -1 do
                            if stopped then break end
                            setStatus(string.format("Đã gửi lệnh (%d người), chờ %ds...", count, i))
                            task.wait(1)
                        end
                        return true
                    end
                end
            end
            cursor = data.nextPageCursor
            if not cursor then break end
        else
            break
        end
    end
    return false
end

-- 2. Fallback: Tìm Server qua Remote Game (Khi HTTP API lỗi hoặc không hỗ trợ)
local function hopViaRemote(maxPlayers)
    local page = 1
    local maxPage = 15
    local now = os.time()
    
    while not stopped and page <= maxPage do
        setStatus(string.format("Quét Remote server <%d người (Trang %d)...", maxPlayers, page))
        
        local ok, servers = pcall(function()
            return ReplicatedStorage.__ServerBrowser:InvokeServer(page)
        end)
        task.wait(0.3)
        
        if ok and type(servers) == "table" and next(servers) ~= nil then
            local candidates = {}
            for jobId, serverData in pairs(servers) do
                if type(serverData) == "table" then
                    local count = tonumber(serverData.Count) or 0
                    if jobId ~= currentJobId and count < maxPlayers and (not TriedHops[jobId] or now > TriedHops[jobId]) then
                        table.insert(candidates, {id = jobId, count = count})
                    end
                end
            end
            
            table.sort(candidates, function(a, b) return a.count < b.count end)
            
            for _, c in ipairs(candidates) do
                if stopped then return false end
                TriedHops[c.id] = now + 180
                setStatus(string.format("Vào server %d người (Remote)...", c.count))
                
                local sent = executeHop(c.id)
                task.wait(2)
                
                if sent and not lastAttemptFailed then
                    return true
                end
            end
        end
        page = page + 1
    end
    return false
end

-- Tổng hợp logic Hop Server
local function hopServer()
    local currentMaxLimit = TARGET_MAX_PLAYERS
    
    while not stopped do
        -- Thử HTTP API trước
        if httpRequest then
            local success = hopViaHTTP(currentMaxLimit)
            if success then return true end
        end
        
        -- Nếu HTTP thất bại hoặc không dùng được, dùng Remote Game
        local successRemote = hopViaRemote(currentMaxLimit)
        if successRemote then return true end
        
        -- Nếu không tìm được server < maxLimit người, nới rộng giới hạn số người
        if currentMaxLimit < 12 then
            currentMaxLimit = currentMaxLimit + 2
            setStatus(string.format("Không có server <%d người, tăng lên %d...", currentMaxLimit - 2, currentMaxLimit))
        else
            setStatus("Không tìm thấy server phù hợp, thử lại sau 3s...")
            task.wait(3)
            currentMaxLimit = TARGET_MAX_PLAYERS
        end
    end
    return false
end

