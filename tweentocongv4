local TweenService = game:GetService("TweenService")
local RunService = game:GetService("RunService")
local Players = game:GetService("Players")

local player = Players.LocalPlayer
local camera = workspace.CurrentCamera
local character = player.Character or player.CharacterAdded:Wait()
local rootPart = character:WaitForChild("HumanoidRootPart")
local humanoid = character:WaitForChild("Humanoid")

-- Toạ độ đích (lấy theo toạ độ mới nhất bạn vừa đề cập)
local targetPosition = Vector3.new(5709.37, 18.81, 270.24)
local speed = 100

-- Các biến lưu trữ quản lý trạng thái
local currentTween = nil
local antiGravity = nil

-- Hàm tính khoảng cách và thời gian
local distance = (rootPart.Position - targetPosition).Magnitude
local timeToTravel = distance / speed

-- 1. Dọn dẹp Tween và trọng lực cũ nếu có trước khi bắt đầu bay mới
if currentTween then currentTween:Cancel() end
if antiGravity then antiGravity:Destroy() end

-- 2. Tạo lực lơ lửng chống rơi
antiGravity = Instance.new("BodyVelocity")
antiGravity.Velocity = Vector3.new(0, 0, 0)
antiGravity.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
antiGravity.Parent = rootPart

-- 3. Khởi tạo Tween
local tweenInfo = TweenInfo.new(timeToTravel, Enum.EasingStyle.Linear)
currentTween = TweenService:Create(rootPart, tweenInfo, {CFrame = CFrame.new(targetPosition)})

-- 4. Vòng lặp Noclip (Học từ code của bạn: Chỉ Noclip khi Tween đang chạy)
RunService.Stepped:Connect(function()
    if currentTween and currentTween.PlaybackState == Enum.PlaybackState.Playing then
        for _, v in pairs(character:GetDescendants()) do
            if v:IsA("BasePart") then 
                v.CanCollide = false 
            end
        end
    end
end)

-- 5. Vòng lặp Fix Camera (Áp dụng cùng logic kiểm tra trạng thái như Noclip)
RunService.RenderStepped:Connect(function()
    if currentTween and currentTween.PlaybackState == Enum.PlaybackState.Playing then
        camera.CameraSubject = humanoid
    end
end)

-- Bắt đầu bay
currentTween:Play()

-- Khi đến nơi thì xóa lực lơ lửng
currentTween.Completed:Connect(function()
    if antiGravity then
        antiGravity:Destroy()
        antiGravity = nil
    end
end)
